    "observability:config": "docker compose -f observability/otel/compose.yaml config --quiet && docker compose -f observability/otel/compose.yaml -f observability/otel/compose.debug.yaml config --quiet",
    "observability:task-results": "uv run python observability/grafana/capture_task_results.py",
    "observability:smoke": "uv run python observability/otel/smoke_test.py",
    "pilot:plan": "uv run python scripts/run_pilot.py plan",
    "validate:repository": "uv run python scripts/validate_repository.py",
    "test": "pnpm observability:config && pnpm --recursive --filter=!kokochi-ui-agent-readability-lab test && uv run pytest -v",
    "test:external": "uv run pytest -v --run-external tests/external",
    "typecheck": "pnpm -r typecheck"
